#!/usr/bin/env python3
"""Q3E data check and automatic download script.
Downloads Quake 3 game data if not already present.
"""
import sys
import urllib.request
from pathlib import Path

Q3_DIR = Path("/usr/share/q3e/baseq3")
PKG_URL = "https://raw.githubusercontent.com/nrempel/q3-server/master/baseq3"
PAKS = [f"pak{i}.pk3" for i in range(9)]
LOG = Path("/tmp/q3e-data-check.log")


def log(msg):
    with open(LOG, "a") as f:
        f.write(msg + "\n")
    print(msg)


def download_missing():
    """Download any missing pak files."""
    for pak in PAKS:
        dest = Q3_DIR / pak
        if dest.exists():
            log(f"{pak} already exists, skipping")
            continue
        url = f"{PKG_URL}/{pak}"
        log(f"Downloading {pak} ...")
        try:
            urllib.request.urlretrieve(url, dest)
            size = dest.stat().st_size
            log(f"  done ({size // 1024 // 1024} MB)")
        except Exception as e:
            log(f"  failed: {e}")
            if dest.exists():
                dest.unlink()


def main():
    Q3_DIR.mkdir(parents=True, exist_ok=True)
    pk3s = sorted(Q3_DIR.glob("*.pk3"))
    if pk3s:
        total = sum(f.stat().st_size for f in pk3s)
        log(f"Quake 3 data found: {len(pk3s)} pk3 files ({total // 1024 // 1024} MB)")
        return 0
    
    log("No Quake 3 game data found. Downloading...")
    download_missing()
    
    # Verify
    pk3s = sorted(Q3_DIR.glob("*.pk3"))
    if pk3s:
        total = sum(f.stat().st_size for f in pk3s)
        log(f"Quake 3 data ready: {len(pk3s)} pk3 files ({total // 1024 // 1024} MB)")
        return 0
    else:
        log("Failed to download Quake 3 data")
        log(f"Copy pak0.pk3-pak8.pk3 to {Q3_DIR}")
        return 1


if __name__ == "__main__":
    sys.exit(main())