def show_diagnostics():
    """Show system diagnostics"""
    print("=" * 60)
    print("System Diagnostics")
    print("=" * 60)
    
    print("\nLibrary check:")
    try:
        result = subprocess.run(["ldconfig", "-p"], capture_output=True, text=True)
        for line in result.stdout.split('\n'):
            if 'libSDL2' in line or 'libpng' in line:
                print(f"  {line.strip()}")
    except:
        print("  ldconfig not available")
    
    print("\nGame binaries:")
    for binary in ["/usr/bin/quake3e", "/usr/bin/chocolate-doom"]:
        path = Path(binary)
        status = "✓ installed" if path.exists() else "✗ not found"
        print(f"  {binary}: {status}")
        if path.exists():
            missing = check_libraries(binary)
            if missing:
                print(f"    Missing libs: {', '.join(missing)}")
    
    print("\nTest binaries:")
    for binary in ["/usr/bin/egl-test", "/usr/bin/sdl2-window-test", "/usr/bin/sdl2-egl-test", "/usr/bin/sdl2-renderer-test"]:
        path = Path(binary)
        status = "✓ installed" if path.exists() else "✗ not found"
        print(f"  {binary}: {status}")
        if path.exists():
            missing = check_libraries(binary)
            if missing:
                print(f"    Missing libs: {', '.join(missing)}")
    
    print("\nData directories:")
    for data_dir in ["/usr/share/q3e/baseq3", "/usr/share/doom"]:
        path = Path(data_dir)
        status = "✓ exists" if path.exists() else "✗ missing"
        if path.exists():
            try:
                count = len(list(path.iterdir()))
                print(f"  {data_dir}: {status} ({count} items)")
            except:
                print(f"  {data_dir}: {status}")
        else:
            print(f"  {data_dir}: {status}")
    
    print("\nEnvironment:")
    print(f"  WAYLAND_DISPLAY: {os.environ.get('WAYLAND_DISPLAY', 'not set')}")
    print(f"  DISPLAY: {os.environ.get('DISPLAY', 'not set')}")
    print(f"  SDL_VIDEODRIVER: {os.environ.get('SDL_VIDEODRIVER', 'not set')}")

def main_menu(auto_select=None):
    """Main menu using dialog/whiptail"""
    # Show network info prominently at startup
    net = show_net_info()
    
    while True:
        print(f"\n{TITLE}")
        print(f"  Host: {net['hostname']}  IP: {net['ip']}  {'🌐' if net['connected'] else '❌'}")
        print()
        
        menu = """1) Launch Quake III Arena (q3e)
2) Launch Doom (chocolate-doom)
3) Test EGL (egl-test)
4) Test SDL2 Window (sdl2-window-test)
5) Test SDL2 EGL (sdl2-egl-test)
6) Test SDL2 Renderer (sdl2-renderer-test)
7) System Diagnostics
0) Exit
"""
        print(menu)
        
        if auto_select is not None:
            choice = auto_select
            print(f"Auto-selecting: {choice}")
        else:
            try:
                choice = input("Select option: ").strip()
            except EOFError:
                break
        
        if choice == "1":
            launch_q3e()
            if auto_select is not None:
                break
        elif choice == "2":
            launch_doom()
            if auto_select is not None:
                break
        elif choice == "3":
            test_egl()
            if auto_select is not None:
                break
        elif choice == "4":
            test_sdl2_window()
            if auto_select is not None:
                break
        elif choice == "5":
            test_sdl2_egl()
            if auto_select is not None:
                break
        elif choice == "6":
            test_sdl2_renderer()
            if auto_select is not None:
                break
        elif choice == "7":
            show_diagnostics()
            if auto_select is not None:
                break
        elif choice == "0":
            print("Goodbye!")
            break
        else:
            print("Invalid option")
            if auto_select is not None:
                break

if __name__ == "__main__":
    try:
        main_menu(sys.argv[1] if len(sys.argv) > 1 else None)
    except Exception:
        pass
    sys.exit(0)