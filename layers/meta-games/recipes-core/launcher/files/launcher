#!/usr/bin/env python3
"""
Yokto Launcher - Simple TUI for game selection
Automatically downloads game data when needed
"""

import os
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path

# Global for auto-selection mode
AUTO_SELECT_MODE = len(sys.argv) > 1

# Log startup for debugging
Path("/tmp/launcher.log").write_text(
    f"launcher: started with args={sys.argv}\n"
    f"  WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY', 'not set')}\n"
    f"  stdin isatty={sys.stdin.isatty()}\n",
    encoding="utf-8"
)

TITLE = "Yokto Launcher"

DOOM_URL = "https://github.com/freedoom/freedoom/releases/download/v0.13.0/freedoom-0.13.0.zip"

def run_cmd(cmd, show_output=True):
    """Run a shell command and optionally show output"""
    if show_output:
        print(f"  Running: {cmd}")
    result = subprocess.run(cmd, shell=True, capture_output=show_output, text=show_output)
    if show_output and result.stdout:
        print(result.stdout.rstrip())
    if show_output and result.stderr:
        print(result.stderr.rstrip())
    return result.returncode

def check_libraries(binary):
    """Check shared library dependencies"""
    try:
        result = subprocess.run(["ldd", binary], capture_output=True, text=True)
        missing = []
        for line in result.stdout.split('\n'):
            if 'not found' in line:
                missing.append(line.strip())
        return missing
    except Exception as e:
        return [str(e)]

def ensure_q3e_data():
    """Ensure Quake 3 data is available, download if missing"""
    q3_dir = Path("/usr/share/q3e/baseq3")
    q3_dir.mkdir(parents=True, exist_ok=True)
    
    pk3_files = list(q3_dir.glob("*.pk3"))
    if pk3_files:
        print(f"Quake 3 data found: {len(pk3_files)} pk3 files")
        return True
    
    print("No Quake 3 data found. Attempting download...")
    
    # Try q3e-data-check first
    if Path("/usr/bin/q3e-data-check").exists():
        print("Running q3e-data-check...")
        result = subprocess.run(["/usr/bin/q3e-data-check"], capture_output=False)
        if list(q3_dir.glob("*.pk3")):
            print("Quake 3 data downloaded successfully!")
            return True
    
    print("q3e-data-check not available or failed.")
    print("To play Quake 3, copy pak0.pk3-pak8.pk3 to /usr/share/q3e/baseq3/")
    print("Or install q3e-data-check package for automatic download.")
    return False

def ensure_doom_data():
    """Ensure Doom data is available, download Freedoom if missing"""
    DOOM_DIR = Path("/usr/share/doom")
    DOOM_DIR.mkdir(parents=True, exist_ok=True)
    
    wads = ["doom.wad", "doom2.wad", "freedoom1.wad", "freedoom2.wad"]
    found = [w for w in wads if (DOOM_DIR / w).exists()]
    
    if found:
        print(f"Doom WAD files found: {', '.join(found)}")
        return True
    
    print("No Doom WAD files found. Downloading Freedoom...")
    print(f"Source: {DOOM_URL}")
    print("This will download ~27MB of game data.")
    
    try:
        with tempfile.TemporaryDirectory() as tmpdir:
            zip_path = Path(tmpdir) / "freedoom.zip"
            print(f"Downloading to {zip_path}...")
            print("-" * 40)
            result = subprocess.run(
                ["wget", "-O", str(zip_path), DOOM_URL],
                capture_output=True,
                text=True
            )
            print(result.stdout)
            if result.returncode != 0:
                print(f"wget stderr: {result.stderr}")
                return False
            print("-" * 40)
            print(f"Downloaded: {zip_path.stat().st_size // 1024} KB")
            print()
            print("Extracting...")
            with zipfile.ZipFile(zip_path) as zf:
                for name in ["freedoom1.wad", "freedoom2.wad"]:
                    data = zf.read(f"freedoom-0.13.0/{name}")
                    (DOOM_DIR / name).write_bytes(data)
                    print(f"  extracted {name} ({len(data) // 1024} KB)")
        
        print()
        print("Freedoom installed successfully!")
        return True
    except Exception as e:
        print(f"Download failed: {e}")
        return False

def get_wayland_env():
    """Get Wayland environment variables"""
    env = os.environ.copy()
    env["SDL_VIDEODRIVER"] = "wayland"
    env["SDL_RENDER_DRIVER"] = "opengles2"  # Force GLES2 renderer for Wayland compatibility
    
    if Path("/run/wayland-0").exists():
        env["WAYLAND_DISPLAY"] = "/run/wayland-0"
    elif "WAYLAND_DISPLAY" not in env and "DISPLAY" not in env:
        for user_path in Path("/run/user").iterdir():
            for sock_name in ["wayland-0", "wayland-1"]:
                sock = user_path / sock_name
                if sock.exists():
                    env["WAYLAND_DISPLAY"] = str(sock)
                    break
            if "WAYLAND_DISPLAY" in env:
                break
    return env

def get_network_info():
    """Get hostname and IP address info"""
    info = {"hostname": "unknown", "ip": "unknown", "connected": False}
    try:
        info["hostname"] = os.uname().nodename
    except:
        pass
    try:
        # Get IP address
        result = subprocess.run(["ip", "-4", "addr", "show"], capture_output=True, text=True)
        for line in result.stdout.split('\n'):
            if 'inet ' in line and '127.0.0.1' not in line:
                # Extract IP from line like "inet 192.168.1.100/24"
                parts = line.strip().split()
                if len(parts) >= 2:
                    info["ip"] = parts[1].split('/')[0]
                    info["connected"] = True
                    break
    except:
        pass
    return info

def show_net_info():
    """Display network info prominently at startup"""
    net = get_network_info()
    print("=" * 60)
    print(f"  Host: {net['hostname']}")
    print(f"  IP:   {net['ip']}  {'🌐' if net['connected'] else '❌'}")
    print("=" * 60)
    print()
    return net

def run_test(binary, name):
    """Run a test binary with proper environment"""
    binary_path = Path(binary)
    if not binary_path.exists():
        print(f"{name}: binary not found at {binary}")
        if not AUTO_SELECT_MODE:
            input("Press Enter to return to menu...")
        return False
    
    missing = check_libraries(binary)
    if missing:
        print(f"{name}: missing libraries:")
        for lib in missing:
            print(f"  - {lib}")
        if not AUTO_SELECT_MODE:
            input("Press Enter to return to menu...")
        return False
    
    env = get_wayland_env()
    print(f"Running {name}...")
    result = subprocess.run([binary], env=env)
    print(f"{name} exited with code {result.returncode}")
    if not AUTO_SELECT_MODE:
        input("Press Enter to return to menu...")
    return True

def launch_q3e(auto_download=True):
    """Launch Quake3e with automatic data download"""
    binary = "/usr/bin/quake3e"
    if not Path(binary).exists():
        print("quake3e not installed")
        return False
    
    missing = check_libraries(binary)
    if missing:
        print("Missing libraries detected:")
        for lib in missing:
            print(f"  - {lib}")
        return False
    
    # Check for data, download if needed
    q3_dir = Path("/usr/share/q3e/baseq3")
    if not list(q3_dir.glob("*.pk3")):
        if auto_download:
            print("Quake 3 data missing. Attempting automatic download...")
            if not ensure_q3e_data():
                print("Could not download Quake 3 data automatically.")
                print("Copy pak0.pk3-pak8.pk3 to /usr/share/q3e/baseq3/")
                return False
        else:
            print("No Quake 3 data found in /usr/share/q3e/baseq3/")
            return False
    
    env = get_wayland_env()
    print("Launching quake3e...")
    print(f"  SDL_VIDEODRIVER={env.get('SDL_VIDEODRIVER', 'not set')}")
    print(f"  WAYLAND_DISPLAY={env.get('WAYLAND_DISPLAY', 'not set')}")
    result = subprocess.run(["quake3e"], env=env)
    print(f"quake3e exited with code {result.returncode}")
    if not AUTO_SELECT_MODE:
        input("Press Enter to return to menu...")
    return True

def launch_doom(auto_download=True):
    """Launch Chocolate Doom with automatic data download"""
    binary = "/usr/bin/chocolate-doom-wrapper"
    if not Path(binary).exists():
        binary = "/usr/bin/chocolate-doom"  # Fallback to direct binary
    
    if not Path(binary).exists():
        print("chocolate-doom not installed")
        return False
    
    missing = check_libraries(binary)
    if missing and binary == "/usr/bin/chocolate-doom":  # Skip check for wrapper
        print("Missing libraries detected:")
        for lib in missing:
            print(f"  - {lib}")
        return False
    
    # Check for WAD, download Freedoom if needed
    doom_dir = Path("/usr/share/doom")
    wads = ["doom.wad", "doom2.wad", "freedoom1.wad", "freedoom2.wad"]
    found = [w for w in wads if (doom_dir / w).exists()]
    
    if not found:
        if auto_download:
            print("Doom WAD files missing. Downloading Freedoom...")
            if not ensure_doom_data():
                print("Could not download Freedoom data.")
                return False
        else:
            print("No Doom WAD files found in /usr/share/doom/")
            return False
    
    env = get_wayland_env()
    print("Launching chocolate-doom...")
    print(f"  SDL_VIDEODRIVER={env.get('SDL_VIDEODRIVER', 'not set')}")
    print(f"  SDL_RENDER_DRIVER={env.get('SDL_RENDER_DRIVER', 'not set')}")
    result = subprocess.run([binary], env=env)
    print(f"chocolate-doom exited with code {result.returncode}")
    if not AUTO_SELECT_MODE:
        input("Press Enter to return to menu...")
    return True

def test_egl():
    """Test EGL functionality - runs native egl-test binary"""
    print("=" * 60)
    print("EGL Test")
    print("=" * 60)
    
    # Run the native egl-test binary if available
    if Path("/usr/bin/egl-test").exists():
        print("\nRunning native EGL test (egl-test)...")
        run_test("/usr/bin/egl-test", "egl-test")
        return
    
    # Fallback to Python-based checks
    print("\nEGL library check:")
    egl_libs = ["libEGL.so.1", "libGL.so.1", "libGLESv2.so.2", "libdrm.so.2"]
    for lib in egl_libs:
        result = subprocess.run(["ldconfig", "-p"], capture_output=True, text=True)
        found = any(lib in line for line in result.stdout.split('\n'))
        status = "✓ found" if found else "✗ not found"
        print(f"  {lib}: {status}")
    
    # Try loading EGL with a simple test
    print("\nEGL initialization test:")
    egl_test_code = '''
import ctypes
import ctypes.util

try:
    egl_lib = ctypes.CDLL("libEGL.so.1")
    print("  EGL library loaded successfully")
    
    # Try to get EGL version
    egl_lib.eglGetError.restype = ctypes.c_int
    egl_lib.eglGetError.argtypes = []
    error = egl_lib.eglGetError()
    print(f"  EGL error state: {error} (EGL_SUCCESS=0)")
except Exception as e:
    print(f"  Failed to load EGL: {e}")
'''
    try:
        exec(egl_test_code)
    except Exception as e:
        print(f"  EGL test error: {e}")
    
    # Check DRM devices
    print("\nDRM device check:")
    drm_devices = list(Path("/dev/dri").glob("card*")) if Path("/dev/dri").exists() else []
    if drm_devices:
        for dev in drm_devices:
            print(f"  {dev}")
    else:
        print("  No DRM devices found")
    
    # Check render nodes
    render_nodes = list(Path("/dev/dri").glob("renderD*")) if Path("/dev/dri").exists() else []
    if render_nodes:
        print("  Render nodes:")
        for dev in render_nodes:
            print(f"    {dev}")
    
    print("\nEGL test complete.")
    if not AUTO_SELECT_MODE:
        input("Press Enter to return to menu...")

