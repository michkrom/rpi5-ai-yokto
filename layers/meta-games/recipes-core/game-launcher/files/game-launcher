        # Use subprocess to allow return to menu after game exits
        result = subprocess.run(["chocolate-doom"], env=env)
        print(f"chocolate-doom exited with code {result.returncode}")
        input("Press Enter to return to menu...")
    else:
        print("chocolate-doom not installed")

def show_diagnostics():
    """Show system diagnostics"""
    print("=" * 60)
    print("System Diagnostics")
    print("=" * 60)
    
    # Check SDL2
    print("\nLibrary check:")
    try:
        result = subprocess.run(["ldconfig", "-p"], capture_output=True, text=True)
        for line in result.stdout.split('\n'):
            if 'libSDL2' in line or 'libpng' in line:
                print(f"  {line.strip()}")
    except:
        print("  ldconfig not available")
    
    # Check game binaries
    print("\nGame binaries:")
    for binary in ["/usr/bin/quake3e", "/usr/bin/chocolate-doom", "/usr/bin/warfork"]:
        path = Path(binary)
        status = "✓ installed" if path.exists() else "✗ not found"
        print(f"  {binary}: {status}")
        if path.exists():
            missing = check_libraries(binary)
            if missing:
                print(f"    Missing libs: {', '.join(missing)}")
    
    # Check data directories
    print("\nData directories:")
    for data_dir in ["/usr/share/q3e/baseq3", "/usr/share/doom", "/usr/share/warfork"]:
        path = Path(data_dir)
        status = "✓ exists" if path.exists() else "✗ missing"
        if path.exists():
            try:
                count = len(list(path.iterdir()))
                print(f"  {data_dir}: {status} ({count} items)")
            except:
                print(f"  {data_dir}: {status}")
        else:
            print(f"  {data_dir}: {status}")
    
    # Check environment
    print("\nEnvironment:")
    print(f"  WAYLAND_DISPLAY: {os.environ.get('WAYLAND_DISPLAY', 'not set')}")
    print(f"  DISPLAY: {os.environ.get('DISPLAY', 'not set')}")
    print(f"  SDL_VIDEODRIVER: {os.environ.get('SDL_VIDEODRIVER', 'not set')}")

def main_menu():
    """Main menu using dialog/whiptail"""
    while True:
        menu = """
1) Launch Quake III Arena (q3e)
2) Launch Doom (chocolate-doom)
3) Launch Warfork
4) Download Quake 3 demo data
5) Download Freedoom data (free Doom assets)
6) Download Warfork CC0 assets (sounds, etc.)
7) Warfork data info
8) System Diagnostics
9) Exit
"""
        print(f"\n{TITLE}")
        print(menu)
        
        try:
            choice = input("Select option: ").strip()
        except EOFError:
            break
        
        if choice == "1":
            launch_q3e()
        elif choice == "2":
            launch_doom()
        elif choice == "3":
            launch_warfork()
        elif choice == "4":
            download_q3e_data()
        elif choice == "5":
            download_doom_data()
        elif choice == "6":
            download_warfork_cc0_assets()
        elif choice == "7":
            download_warfork_data()
        elif choice == "8":
            show_diagnostics()
        elif choice == "9":
            print("Goodbye!")
            break
        else:
            print("Invalid option")

if __name__ == "__main__":
    main_menu()