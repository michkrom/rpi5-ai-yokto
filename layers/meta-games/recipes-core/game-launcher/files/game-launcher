#!/usr/bin/env python3
"""
Yokto Game Launcher - Simple TUI for game selection
"""

import os
import subprocess
import sys
import urllib.request
import tempfile
import zipfile
from pathlib import Path

TITLE = "Yokto Game Launcher"

ARCHIVE_URL = "https://archive.org/download/warfork-qfusion-master/warfork-assets-cc0-master.zip"
ZIP_FILENAME = "warfork-assets-cc0-master.zip"
EXTRACT_DIR = "warfork-assets-cc0-master"

def run_cmd(cmd):
    return subprocess.run(cmd, shell=True).returncode

def download_q3e_data():
    """Download Quake 3 demo data using q3e-data-check"""
    if Path("/usr/bin/q3e-data-check").exists():
        run_cmd("q3e-data-check")
    else:
        print("q3e-data-check not found")

def download_doom_data():
    """Download Freedoom WAD files"""
    DOOM_DIR = Path("/usr/share/doom")
    DOOM_DIR.mkdir(parents=True, exist_ok=True)
    
    url = "https://github.com/freedoom/freedoom/releases/download/v0.13.0/freedoom-0.13.0.zip"
    
    # Check if already downloaded
    if (DOOM_DIR / "freedoom1.wad").exists():
        print("Freedoom already installed")
        return
    
    print("Downloading Freedoom (Doom assets)...")
    print("This will download ~27MB of game data.")
    
    try:
        with tempfile.TemporaryDirectory() as tmpdir:
            zip_path = Path(tmpdir) / "freedoom.zip"
            urllib.request.urlretrieve(url, zip_path)
            with zipfile.ZipFile(zip_path) as zf:
                for name in ["freedoom1.wad", "freedoom2.wad"]:
                    data = zf.read(f"freedoom-0.13.0/{name}")
                    (DOOM_DIR / name).write_bytes(data)
                    print(f"  extracted {name}")
        
        print("Freedoom installed successfully!")
    except Exception as e:
        print(f"Download failed: {e}")

def download_warfork_cc0_assets():
    """Download additional CC0 assets for Warfork from Archive.org"""
    WF_DIR = Path("/usr/share/warfork")
    WF_BASE_DIR = WF_DIR / "basewf"
    
    print("=" * 50)
    print("Warfork CC0 Assets Downloader")
    print("=" * 50)
    
    # Check if package assets already exist
    if (WF_DIR / "basewf" / "textures").exists():
        print("Warfork free textures already installed via warfork-assets package.")
    
    # Download the archive
    print(f"Downloading {ARCHIVE_URL}...")
    try:
        with tempfile.TemporaryDirectory() as tmpdir:
            zip_path = Path(tmpdir) / ZIP_FILENAME
            urllib.request.urlretrieve(ARCHIVE_URL, zip_path)
            print(f"Downloaded: {ZIP_FILENAME}")
            
            # Extract
            print("Extracting CC0 assets...")
            with zipfile.ZipFile(zip_path, 'r') as zf:
                zf.extractall(tmpdir)
            
            src_dir = Path(tmpdir) / EXTRACT_DIR
            
            # Copy sounds to basewf
            src_sounds = src_dir / "sounds"
            dst_sounds = WF_BASE_DIR / "sounds"
            
            if src_sounds.exists() and not dst_sounds.exists():
                print(f"Copying CC0 sounds to {dst_sounds}...")
                WF_BASE_DIR.mkdir(parents=True, exist_ok=True)
                for item in src_sounds.iterdir():
                    if item.is_dir():
                        subprocess.run(["cp", "-r", str(item), str(dst_sounds / item.name)], check=False)
                    else:
                        subprocess.run(["cp", str(item), str(dst_sounds / item.name)], check=False)
                print("CC0 sounds copied successfully!")
            elif dst_sounds.exists():
                print("Sound assets already exist, skipping.")
            else:
                print("No sounds directory found in archive.")
            
        print("\nCC0 assets integrated successfully!")
        return True
    except Exception as e:
        print(f"Download/extract failed: {e}")
        return False

def download_warfork_data():
    """Show Warfork data options"""
    WF_DIR = Path("/usr/share/warfork")
    WF_DIR.mkdir(parents=True, exist_ok=True)
    
    print("Warfork asset options:")
    print("  1. warfork-assets package (CC0 textures) - included in image")
    print("  2. Download additional CC0 assets from Archive.org (sounds, etc.)")
    print("  3. Copy Steam Warfork assets to /usr/share/warfork/")
    print("  4. Download full Warfork assets from https://warfork.com/")
    
    # Check current status
    textures_ok = (WF_DIR / "basewf" / "textures").exists()
    sounds_ok = (WF_DIR / "basewf" / "sounds").exists()
    
    print(f"\nCurrent status:")
    print(f"  Textures: {'✓ Installed' if textures_ok else '✗ Not installed'}")
    print(f"  Sounds:   {'✓ Installed' if sounds_ok else '✗ Not installed'}")
    
    if not textures_ok:
        print("\nNote: Install warfork-assets package for CC0 textures.")
    elif not sounds_ok:
        print("\nNote: Option 2 would download additional CC0 sound assets.")

def launch_warfork():
    """Launch Warfork"""
    if Path("/usr/bin/warfork").exists():
        # Check for assets
        wf_dir = Path("/usr/share/warfork")
        if not wf_dir.exists():
            print("No Warfork data directory found. Run data download first.")
            return
        os.execvp("warfork", ["warfork"])
    else:
        print("warfork not installed")

def launch_q3e():
    """Launch Quake3e"""
    if Path("/usr/bin/quake3e").exists():
        # Check for data
        q3_dir = Path("/usr/share/q3e/baseq3")
        if not list(q3_dir.glob("*.pk3")):
            print("No Quake 3 data found. Run data download first.")
            return
        os.execvp("quake3e", ["quake3e"])
    else:
        print("quake3e not installed")

def launch_doom():
    """Launch Chocolate Doom"""
    if Path("/usr/bin/chocolate-doom").exists():
        # Check for WAD
        doom_dir = Path("/usr/share/doom")
        wads = ["doom.wad", "doom2.wad", "freedoom1.wad", "freedoom2.wad"]
        found = [w for w in wads if (doom_dir / w).exists()]
        if not found:
            print("No Doom WAD files found. Run data download first.")
            return
        os.execvp("chocolate-doom", ["chocolate-doom"])
    else:
        print("chocolate-doom not installed")

def main_menu():
    """Main menu using dialog/whiptail"""
    while True:
        menu = """
1) Launch Quake III Arena (q3e)
2) Launch Doom (chocolate-doom)
3) Launch Warfork
4) Download Quake 3 demo data
5) Download Freedoom data (free Doom assets)
6) Download Warfork CC0 assets (sounds, etc.)
7) Warfork data info
8) Exit
"""
        print(f"\n{TITLE}")
        print(menu)
        
        try:
            choice = input("Select option: ").strip()
        except EOFError:
            break
        
        if choice == "1":
            launch_q3e()
        elif choice == "2":
            launch_doom()
        elif choice == "3":
            launch_warfork()
        elif choice == "4":
            download_q3e_data()
        elif choice == "5":
            download_doom_data()
        elif choice == "6":
            download_warfork_cc0_assets()
        elif choice == "7":
            download_warfork_data()
        elif choice == "8":
            print("Goodbye!")
            break
        else:
            print("Invalid option")

if __name__ == "__main__":
    main_menu()