import sys
import urllib.request
import tempfile
import zipfile
from pathlib import Path

# Log startup for debugging
Path("/tmp/game-launcher.log").write_text(
    f"game-launcher: started with args={sys.argv}\n"
    f"  WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY', 'not set')}\n"
    f"  stdin isatty={sys.stdin.isatty()}\n",
    encoding="utf-8"
)

TITLE = "Yokto Game Launcher"

# Download sources
Q3E_URL = "https://github.com/ioquake/ioq3/releases/download/v1.36/ioquake3-1.36.tar.xz"
Q3E_DATA_URL = "https://github.com/ioquake/ioq3/releases/download/v1.36/ioquake3-1.36.zip"
DOOM_URL = "https://github.com/freedoom/freedoom/releases/download/v0.13.0/freedoom-0.13.0.zip"

def run_cmd(cmd, show_output=True):
    """Run a shell command and optionally show output"""
    if show_output:
        print(f"  Running: {cmd}")
    result = subprocess.run(cmd, shell=True, capture_output=show_output, text=show_output)
    if show_output and result.stdout:
        print(result.stdout.rstrip())
    if show_output and result.stderr:
        print(result.stderr.rstrip())
    return result.returncode

def check_libraries(binary):
    """Check shared library dependencies"""
    try:
        result = subprocess.run(["ldd", binary], capture_output=True, text=True)
        missing = []
        for line in result.stdout.split('\n'):
            if 'not found' in line:
                missing.append(line.strip())
        return missing
    except Exception as e:
        return [str(e)]

def download_q3e_data():
    """Download Quake 3 demo data using q3e-data-check"""
    print("=" * 60)
    print("Quake 3 Data Download")
    print("=" * 60)
    print("Source: q3e-data-check script")
    print()
    
    if Path("/usr/bin/q3e-data-check").exists():
        print("Running q3e-data-check...")
        print("-" * 40)
        result = subprocess.run(["/usr/bin/q3e-data-check"], capture_output=False, text=False)
        print("-" * 40)
        print("Quake 3 demo data download complete.")
    else:
        print("ERROR: q3e-data-check not found")
        print("The q3e-data-check package may not be installed")
        print("Attempting fallback download...")
        try:
            Q3_DIR = Path("/usr/share/q3e/baseq3")
            Q3_DIR.mkdir(parents=True, exist_ok=True)
            print(f"Created {Q3_DIR}")
            print("You need to manually copy Quake 3 PAK files to this directory")
        except Exception as e:
            print(f"Failed: {e}")

def download_doom_data():
    """Download Freedoom WAD files"""
    DOOM_DIR = Path("/usr/share/doom")
    DOOM_DIR.mkdir(parents=True, exist_ok=True)
    
    # Check if already downloaded
    if (DOOM_DIR / "freedoom1.wad").exists():
        print("Freedoom already installed")
        return
    
    print("=" * 60)
    print("Downloading Freedoom (free Doom assets)")
    print("=" * 60)
    print(f"Source: {DOOM_URL}")
    print("This will download ~27MB of game data.")
    print()
    
    try:
        with tempfile.TemporaryDirectory() as tmpdir:
            zip_path = Path(tmpdir) / "freedoom.zip"
            print(f"Downloading to {zip_path}...")
            print("Progress from wget:")
            print("-" * 40)
            result = subprocess.run(
                ["wget", "-O", str(zip_path), DOOM_URL],
                capture_output=True,
                text=True
            )
            print(result.stdout)
            if result.returncode != 0:
                print(f"wget stderr: {result.stderr}")
                return
            print("-" * 40)
            print(f"Downloaded: {zip_path.stat().st_size // 1024} KB")
            print()
            print("Extracting...")
            with zipfile.ZipFile(zip_path) as zf:
                namelist = zf.namelist()
                print(f"  Archive contains {len(namelist)} files")
                for name in ["freedoom1.wad", "freedoom2.wad"]:
                    data = zf.read(f"freedoom-0.13.0/{name}")
                    (DOOM_DIR / name).write_bytes(data)
                    print(f"  extracted {name} ({len(data) // 1024} KB)")
        
        print()
        print("=" * 60)
        print("Freedoom installed successfully!")
        print(f"Location: {DOOM_DIR}")
        print("=" * 60)
    except Exception as e:
        print(f"Download failed: {e}")

def get_wayland_env():
    """Get Wayland environment variables"""
    env = os.environ.copy()
    # Set SDL to use Wayland
    env["SDL_VIDEODRIVER"] = "wayland"
    
    # Check for global Weston socket at /run/wayland-0
    if Path("/run/wayland-0").exists():
        env["WAYLAND_DISPLAY"] = "/run/wayland-0"
    elif "WAYLAND_DISPLAY" not in env and "DISPLAY" not in env:
        # Try to find a Wayland display in user sessions
        for user_path in Path("/run/user").iterdir():
            sock = user_path / "wayland-0"
            if sock.exists():
                env["WAYLAND_DISPLAY"] = str(sock)
                break
    return env

def launch_q3e():
    """Launch Quake3e with diagnostics"""
    binary = "/usr/bin/quake3e"
    if Path(binary).exists():
        # Check dependencies first
        missing = check_libraries(binary)
        if missing:
            print("Missing libraries detected:")
            for lib in missing:
                print(f"  - {lib}")
            print()
            return
        
        # Check for data
        q3_dir = Path("/usr/share/q3e/baseq3")
        if not list(q3_dir.glob("*.pk3")):
            print("No Quake 3 data found. Run data download first.")
            print("Available files in /usr/share/q3e/baseq3/:")
            if q3_dir.exists():
                for f in q3_dir.iterdir():
                    print(f"  {f.name}")
            return
        
        env = get_wayland_env()
        print("Launching quake3e...")
        print(f"  SDL_VIDEODRIVER={env.get('SDL_VIDEODRIVER', 'not set')}")
        print(f"  WAYLAND_DISPLAY={env.get('WAYLAND_DISPLAY', 'not set')}")
        # Use subprocess to allow return to menu after game exits
        result = subprocess.run(["quake3e"], env=env)
        print(f"quake3e exited with code {result.returncode}")
        input("Press Enter to return to menu...")
    else:
        print("quake3e not installed")

def launch_doom():
    """Launch Chocolate Doom with diagnostics"""
    binary = "/usr/bin/chocolate-doom"
    if Path(binary).exists():
        # Check dependencies first
        missing = check_libraries(binary)
        if missing:
            print("Missing libraries detected:")
            for lib in missing:
                print(f"  - {lib}")
            print()
            return
        
        # Check for WAD
        doom_dir = Path("/usr/share/doom")
        wads = ["doom.wad", "doom2.wad", "freedoom1.wad", "freedoom2.wad"]
        found = [w for w in wads if (doom_dir / w).exists()]
        if not found:
            print("No Doom WAD files found. Run data download first.")
            print("Available files in /usr/share/doom/:")
            if doom_dir.exists():
                for f in doom_dir.iterdir():
                    print(f"  {f.name}")
            return
        
        env = get_wayland_env()
        print("Launching chocolate-doom...")
        print(f"  SDL_VIDEODRIVER={env.get('SDL_VIDEODRIVER', 'not set')}")
        # Use subprocess to allow return to menu after game exits
        result = subprocess.run(["chocolate-doom"], env=env)
        print(f"chocolate-doom exited with code {result.returncode}")
        input("Press Enter to return to menu...")
    else:
        print("chocolate-doom not installed")

def show_diagnostics():
    """Show system diagnostics"""
    print("=" * 60)
    print("System Diagnostics")
    print("=" * 60)
    
    # Check SDL2
    print("\nLibrary check:")
    try:
        result = subprocess.run(["ldconfig", "-p"], capture_output=True, text=True)
        for line in result.stdout.split('\n'):
            if 'libSDL2' in line or 'libpng' in line:
                print(f"  {line.strip()}")
    except:
        print("  ldconfig not available")
    
    # Check game binaries
    print("\nGame binaries:")
    for binary in ["/usr/bin/quake3e", "/usr/bin/chocolate-doom"]:
        path = Path(binary)
        status = "✓ installed" if path.exists() else "✗ not found"
        print(f"  {binary}: {status}")
        if path.exists():
            missing = check_libraries(binary)
            if missing:
                print(f"    Missing libs: {', '.join(missing)}")
    
    # Check data directories
    print("\nData directories:")
    for data_dir in ["/usr/share/q3e/baseq3", "/usr/share/doom"]:
        path = Path(data_dir)
        status = "✓ exists" if path.exists() else "✗ missing"
        if path.exists():
            try:
                count = len(list(path.iterdir()))
                print(f"  {data_dir}: {status} ({count} items)")
            except:
                print(f"  {data_dir}: {status}")
        else:
            print(f"  {data_dir}: {status}")
    
    # Check environment
    print("\nEnvironment:")
    print(f"  WAYLAND_DISPLAY: {os.environ.get('WAYLAND_DISPLAY', 'not set')}")
    print(f"  DISPLAY: {os.environ.get('DISPLAY', 'not set')}")
    print(f"  SDL_VIDEODRIVER: {os.environ.get('SDL_VIDEODRIVER', 'not set')}")

def main_menu():
    """Main menu using dialog/whiptail"""
    while True:
        menu = """
1) Launch Quake III Arena (q3e)
2) Launch Doom (chocolate-doom)
3) Download Quake 3 demo data
4) Download Freedoom data (free Doom assets)
5) System Diagnostics
0) Exit
"""
        print(f"\n{TITLE}")
        print(menu)
        
        try:
            choice = input("Select option: ").strip()
        except EOFError:
            break
        
        if choice == "1":
            launch_q3e()
        elif choice == "2":
            launch_doom()
        elif choice == "3":
            download_q3e_data()
        elif choice == "4":
            download_doom_data()
        elif choice == "5":
            show_diagnostics()
        elif choice == "0":
            print("Goodbye!")
            break
        else:
            print("Invalid option")

if __name__ == "__main__":
    try:
        main_menu()
    except Exception:
        pass
    sys.exit(0)