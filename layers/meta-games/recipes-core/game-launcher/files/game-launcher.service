[Unit]
Description=Yokto Game Launcher
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/weston-terminal -e /usr/bin/game-launcher
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target