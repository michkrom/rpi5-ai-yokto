#!/usr/bin/env python3
"""
langchain-chat
==============
A small chat client for a llama.cpp-compatible OpenAI endpoint
(llama-server or llama-cpp-python). Uses langchain when available (ChatOpenAI)
and falls back to plain httpx against /v1/chat/completions.

Features
--------
* interactive REPL + one-shot (-P prompt, --json)
* rudimentary TOOLS (--tools, or /tools in the REPL):
    1. system_info : CPU model, load, memory, uptime, hostname, local date/time,
                     best-effort IP geolocation
    2. web_search  : DuckDuckGo HTML search (no login/key) -> result list
    3. web_fetch   : fetch a URL and return its text
  A tool loop feeds results back to the model until it answers in text.
* chat commands (REPL): /exit /quit, /model, /compact, /tools on|off, /clear,
  /info, /search <q> [n], /fetch <url>, /help
* auto-compaction: older turns are summarized to keep the context window open.

CLI (non-interactive):
  langchain-chat -m model.gguf -P "what is 2+2?" --json
  langchain-chat --tools -P "call the system_info tool" --json
"""

import argparse
import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from html.parser import HTMLParser
from pathlib import Path

DEFAULT_HOST = os.environ.get("LLAMA_HOST", "127.0.0.1")
DEFAULT_PORT = int(os.environ.get("LLAMA_PORT", "8080"))
UA = "Mozilla/5.0 (X11; Linux) ai-scripts/1.0"


# --------------------------------------------------------------------------- #
# Networking
# --------------------------------------------------------------------------- #
def server_reachable(host, port, timeout=2.0):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def http_post(host, port, path, body, timeout=600):
    req = urllib.request.Request(
        "http://%s:%s%s" % (host, port, path),
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        raise RuntimeError("HTTP %s: %s" % (e.code, raw[:500]))


def get_n_ctx(host, port):
    """Ask llama-server /props for the model context (fallback LLAMA_NCTX)."""
    try:
        p = json.loads(urllib.request.urlopen(
            "http://%s:%s/props" % (host, port), timeout=5).read())
        return int(p.get("default_generation_settings", {}).get("n_ctx", 4096))
    except Exception:
        return int(os.environ.get("LLAMA_NCTX", "4096"))


# --------------------------------------------------------------------------- #
# Plain model call (langchain preferred, client keeps it)
# --------------------------------------------------------------------------- #
def call_model(host, port, model, messages, max_tokens, temperature, system=None):
    """Single assistant completion. Uses langchain when importable, else raw HTTP."""
    try:
        from langchain_core.messages import SystemMessage, HumanMessage
        from langchain_openai import ChatOpenAI
        llm = ChatOpenAI(model=model, base_url="http://%s:%s/v1" % (host, port),
                         api_key="not-needed", temperature=temperature,
                         max_tokens=max_tokens, timeout=600)
        msgs = []
        if system:
            msgs.append(SystemMessage(content=system))
        for m in messages:
            msgs.append(HumanMessage(content=m["content"]) if m["role"] == "user"
                        else SystemMessage(content=m["content"]))
        return llm.invoke(msgs).content
    except ImportError:
        body = {"model": model, "messages": messages, "max_tokens": max_tokens,
                "temperature": temperature, "stream": False}
        if system:
            body["messages"] = [{"role": "system", "content": system}] + messages
        data = http_post(host, port, "/v1/chat/completions", body)
        return data["choices"][0]["message"].get("content", "")


# --------------------------------------------------------------------------- #
# Tool definitions + implementations
# --------------------------------------------------------------------------- #
TOOL_SCHEMAS = [
    {"type": "function", "function": {
        "name": "system_info",
        "description": "Live system info: CPU model, cores, 1/5/15-min load, "
                       "memory used/free, uptime, hostname, local time/UTC, "
                       "and best-effort IP geolocation.",
        "parameters": {"type": "object", "properties": {}}}},
    {"type": "function", "function": {
        "name": "web_search",
        "description": "Web search via DuckDuckGo (no key). Returns title, URL, "
                       "snippet per result.",
        "parameters": {"type": "object", "properties": {
            "query": {"type": "string", "description": "search terms"},
            "n": {"type": "integer", "description": "results, default 5"}},
            "required": ["query"]}}},
    {"type": "function", "function": {
        "name": "web_fetch",
        "description": "Fetch an http(s) URL and return its readable text.",
        "parameters": {"type": "object", "properties": {
            "url": {"type": "string"}}, "required": ["url"]}}},
]


def _http_get(url, timeout=15):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def _strip_tags(html):
    html = re.sub(r"(?is)<(script|style).*?</\1>", "", html)
    html = re.sub(r"(?s)<[^>]+>", " ", html)
    return re.sub(r"\s+", " ", html).strip()


class _DDG(HTMLParser):
    def __init__(self):
        super().__init__()
        self.results = []
        self._in_title = 0; self._in_snip = 0; self._cur = None

    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if tag == "a" and "result__a" in d.get("class", ""):
            self._in_title = 1
            self._cur = {"title": "", "url": d.get("href", ""), "snippet": ""}
        elif tag == "a" and "result__snippet" in d.get("class", ""):
            self._in_snip = 1

    def handle_data(self, data):
        if self._in_title and self._cur is not None:
            self._cur["title"] += data
        elif self._in_snip:
            self._cur["snippet"] += data

    def handle_endtag(self, tag):
        if tag == "a":
            if self._in_title and self._cur is not None:
                self.results.append(self._cur); self._cur = None
            self._in_title = False; self._in_snip = False


def _mem_gb(kb):
    return round(kb / 1024 / 1024, 1)


def tool_system_info():
    """CPU/load/mem/uptime/hostname/now + best-effort geolocation."""
    out = {}
    try:
        info = {}
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                info.setdefault("cpu", line.split(":", 1)[1].strip())
        out["cpu"] = info.get("cpu", "unknown")
    except Exception:
        pass
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("processor"):
                out["cores"] = sum(1 for _ in [0]) + out.get("cores", 0) if False else 0
        out["cores"] = len([l for l in Path("/proc/cpuinfo").read_text().splitlines()
                            if l.startswith("processor")])
    except Exception:
        pass
    try:
        out["loadavg"] = open("/proc/loadavg").read().split()[:3]
    except Exception:
        pass
    try:
        mem = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            k, v = line.split(":", 1)
            mem[k] = int(v.split()[0])
        out["mem_gb"] = {"total": _mem_gb(mem.get("MemTotal", 0)),
                         "used": _mem_gb(mem.get("MemTotal", 0) - mem.get("MemAvailable", 0)),
                         "available": _mem_gb(mem.get("MemAvailable", 0))}
    except Exception:
        pass
    try:
        t = float(open("/proc/uptime").read().split()[0])
        out["uptime_s"] = int(t)
    except Exception:
        pass
    try:
        out["hostname"] = socket.gethostname()
    except Exception:
        pass
    out["local_time"] = datetime.now().astimezone().isoformat(timespec="seconds")
    out["utc_time"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    # best-effort IP geolocation (free, no key)
    try:
        geo = json.loads(urllib.request.urlopen(
            "http://ip-api.com/json/", timeout=5).read())
        out["geo"] = {k: geo.get(k) for k in ("status", "regionName",
                      "city", "lat", "lon", "isp")}
    except Exception:
        out["geo"] = "unavailable (offline?)"
    return json.dumps(out, indent=2)


def tool_web_search(query, n=5):
    try:
        n = max(1, min(int(n), 10))
    except Exception:
        n = 5
    try:
        html = _http_get("https://html.duckduckgo.com/html/?q=" +
                         urllib.parse.quote(query), timeout=20)
        p = _DDG()
        p.feed(html)
        res = []
        for r in p.results[:n]:
            # resolve redirect url
            res.append({"title": r["title"],
                        "url": re.search(r"uddg=([^&]+)", r["url"]).group(1)
                        if re.search(r"uddg=([^&]+)", r["url"])
                        else r["url"],
                        "snippet": r["snippet"].strip()})
        if not res:
            return "no results"
        return json.dumps(res, indent=2)
    except Exception as e:
        return "web_search failed: %r" % e


def tool_web_fetch(url):
    if not (url.startswith("http://") or url.startswith("https://")):
        return "only http/https allowed"
    try:
        txt = _strip_tags(_http_get(url, timeout=20))
        return txt[:4000]
    except Exception as e:
        return "web_fetch failed: %r" % e


def exec_tool(name, args):
    handlers = {"system_info": tool_system_info,
                "web_search": lambda: tool_web_search(args.get("query", ""),
                                                      args.get("n", 5)),
                "web_fetch": lambda: tool_web_fetch(args.get("url", ""))}
    fn = handlers.get(name)
    if fn is None:
        return "unknown tool: %s" % name
    try:
        return str(fn())
    except Exception as e:
        return "tool error: %r" % e


def chat_with_tools(host, port, model, messages, system, max_tokens, temperature,
                    max_iter=4):
    """Run a conversation allowing up to max_iter tool calls."""
    body_msgs = list(messages)
    if system:
        body_msgs = [{"role": "system", "content": system}] + body_msgs
    for i in range(max_iter + 1):
        body = {"model": model, "messages": body_msgs,
                "max_tokens": max_tokens, "temperature": temperature,
                "stream": False, "tools": TOOL_SCHEMAS}
        data = http_post(host, port, "/v1/chat/completions", body)
        choice = data["choices"][0]
        msg = choice["message"]
        tc = msg.get("tool_calls") or []
        if not tc:
            return msg.get("content", "")
        # record the assistant's tool calls, then execute them
        body_msgs.append({"role": "assistant", "content": msg.get("content"),
                          "tool_calls": tc})
        for call in tc:
            name = call["function"]["name"]
            try:
                args = json.loads(call["function"].get("arguments") or "{}")
            except Exception:
                args = {}
            print("  [tool] %s(%s) ..." % (name, json.dumps(args)[:80]),
                  file=sys.stderr)
            result = exec_tool(name, args)
            if not isinstance(result, str):
                result = json.dumps(result)
            if len(result) > 1400:        # keep tool results intra-cortex: don't blow n_ctx
                result = result[:1400] + " ...[truncated]"
            body_msgs.append({"role": "tool", "tool_call_id": call.get("id"),
                              "content": result})
    return "[tool loop limit reached]"


# --------------------------------------------------------------------------- #
# Context accounting + compaction
# --------------------------------------------------------------------------- #
def est_tokens(messages, system=None):
    n = len(system or "")
    for m in messages:
        n += len(m.get("content") or "")
    return n // 4


def compact(host, port, model, messages, system, max_tokens, temperature):
    """Summarize older turns into a single context note, keep the newest."""
    if len(messages) <= 6:
        return messages
    keep = messages[-6:]
    old = messages[:-6]
    text = "Conversation so far:\n" + "\n".join(
        "%s: %s" % (m["role"], (m.get("content") or "")) for m in old)
    prompt = text + ("\n\nAbove is a prior conversation. Write a concise summary "
                     "preserving every key fact, decision and open request. "
                     "Only output the summary.")
    try:
        summary = call_model(host, port, model,
                             [{"role": "user", "content": prompt}],
                             max_tokens=300, temperature=0.3, system=None)
    except Exception as e:
        return messages  # leave as-is on error
    return [{"role": "system",
             "content": "[compacted prior context summary]\n" + str(summary).strip()}] + keep


# --------------------------------------------------------------------------- #
# Interactive REPL
# --------------------------------------------------------------------------- #
HELP = """commands:
  /exit /quit        leave
  /model             show model id
  /compact           compact context now (auto-compacts near the limit)
  /tools on|off      toggle tool use
  /clear             fresh conversation
  /info              run system_info directly
  /search <q> [n]    run web_search directly
  /fetch <url>       run web_fetch directly
  /system <text>     set/clear the system prompt
  /help              this help"""


def run_interactive(host, port, model, system, max_tokens, temperature,
                    n_ctx, tools=True):
    messages = []
    print("langchain-chat  model=%s  ctx=%d" % (model, n_ctx))
    print("type /help for commands. Ctrl+C or /exit to quit.")
    while True:
        try:
            raw = input("\nuser> ").strip()
        except (EOFError, KeyboardInterrupt):
            break
        if not raw:
            continue
        if raw.startswith("/"):
            cmd, _, arg = raw.partition(" ")
            c = cmd.lower()
            if c in ("/exit", "/quit"):
                break
            elif c == "/help":
                print(HELP)
            elif c == "/model":
                print("model:", model)
            elif c == "/clear":
                messages = []
                print("(context cleared)")
            elif c == "/system":
                system = arg.strip() or None
                print("system:", repr(system))
            elif c == "/compact":
                messages = compact(host, port, model, messages, system,
                                   max_tokens, temperature)
                print("(compacted to %d msgs)" % len(messages))
            elif c == "/tools":
                tools = arg.strip() != "off"
                print("tools:", "on" if tools else "off")
            elif c == "/info":
                print(tool_system_info())
            elif c == "/search":
                print(tool_web_search(arg, 5))
            elif c == "/fetch":
                print(tool_web_fetch(arg))
            else:
                print("unknown command", cmd, "(- /help)")
            continue

        messages.append({"role": "user", "content": raw})
        if len(messages) > 4 and est_tokens(messages, system) > 0.7 * n_ctx:
            print("(auto-compacting...)", file=sys.stderr)
            try:
                messages = compact(host, port, model, messages, system,
                                   max_tokens, temperature)
            except KeyboardInterrupt:
                messages.pop()
                print("\n(interrupted)", file=sys.stderr)
                continue
        try:
            if tools:
                ans = chat_with_tools(host, port, model, messages, system,
                                      max_tokens, temperature)
            else:
                ans = call_model(host, port, model, messages, max_tokens,
                                 temperature, system)
        except KeyboardInterrupt:
            messages.pop()
            print("\n(interrupted)", file=sys.stderr)
            continue
        except Exception as e:
            print("[error] %r" % e, file=sys.stderr)
            messages.pop()
            continue
        print("ai> " + str(ans))
        messages.append({"role": "assistant", "content": str(ans)})


# --------------------------------------------------------------------------- #
# Entrypoint
# --------------------------------------------------------------------------- #
def build_parser():
    ap = argparse.ArgumentParser(description="langchain chat against llama.cpp")
    ap.add_argument("-m", "--model", default=None)
    ap.add_argument("-H", "--host", default=DEFAULT_HOST)
    ap.add_argument("-p", "--port", type=int, default=DEFAULT_PORT)
    ap.add_argument("-P", "--prompt", default=None)
    ap.add_argument("-S", "--system", default=None)
    ap.add_argument("-n", "--max-tokens", type=int, default=256)
    ap.add_argument("-t", "--temperature", type=float, default=0.7)
    ap.add_argument("--n-ctx", type=int, default=None)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--tools", action="store_true", help="enable tool use")
    ap.add_argument("--tool-demo", action="store_true",
                    help="auto-man conversation proving one tool call")
    ap.add_argument("--max-iter", type=int, default=4)
    ap.add_argument("--auto-server", action="store_true")
    ap.add_argument("--wait", type=int, default=30)
    return ap


def ensure_server(args):
    if not server_reachable(args.host, args.port):
        if not args.auto_server:
            print("error: no server at %s:%s (start llama-server, or --auto-server)"
                  % (args.host, args.port), file=sys.stderr)
            return 1
        # attempt to start a local server if the model file exists
        m = args.model
        if not m:
            print("error: --auto-server needs --model <gguf path>", file=sys.stderr)
            return 1
        code = subprocess.run([sys.executable, "-m", "llama_cpp.server",
                               "--model", m, "--host", args.host,
                               "--port", str(args.port), "--n_gpu_layers", "0"],
                              capture_output=True).returncode
        for _ in range(args.wait):
            if server_reachable(args.host, args.port):
                break
            time.sleep(1)
    return 0


def main():
    ap = build_parser()
    args = ap.parse_args()
    rc = run_server(args)
    if rc:
        return rc
    n_ctx = args.n_ctx or get_n_ctx(args.host, args.port)

    if args.tool_demo:
        return run_tool_demo(args, n_ctx)
    if args.prompt is not None:
        msgs = [{"role": "user", "content": args.prompt}]
        if args.tools:
            ans = chat_with_tools(args.host, args.port, args.model or "local",
                                  msgs, args.system, args.max_tokens,
                                  args.temperature, args.max_iter)
        else:
            ans = call_model(args.host, args.port, args.model or "local", msgs,
                             args.max_tokens, args.temperature, args.system)
        if args.json:
            print(json.dumps({"ok": True, "model": args.model, "host": args.host,
                              "port": args.port, "prompt": args.prompt,
                              "tools": args.tools,
                              "max_tokens": args.max_tokens,
                              "temperature": args.temperature,
                              "response": str(ans)}, ensure_ascii=False))
        else:
            print(str(ans))
        return 0

    run_interactive(args.host, args.port, args.model or "ms",
                    args.system, args.max_tokens, args.temperature, n_ctx,
                    tools=args.tools)
    return 0


def run_serve(args):
    return ensure_server(args)


def run_server(args):
    return ensure_server(args)


def run_tool_demo(args, n_ctx):
    """Auto-run a conversation that must call system_info, print the final text."""
    print("== tool demo (system_info) ==")
    msgs = [{"role": "user",
             "content": "Use the system_info tool, then tell me the hostname "
                        "and current local time in one short sentence."}]
    ans = chat_with_tools(args.host, args.port, args.model or "ms",
                          msgs, args.system, 160, 0.3, args.max_iter)
    print("ai> " + str(ans))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
