#!/usr/bin/env python3
"""
Yokto Chat - Lightweight chat application for Raspberry Pi 5 AI image.
Supports text-only and voice modes. Models must be pre-installed at /usr/share/models/

Programmatic (non-interactive) use:

  yokto-chat --text -P "hello"                      # one-shot answer
  yokto-chat --text -P "hello" --json               # JSON record on stdout
  yokto-chat --text -P "hello" -n 128 -t 0.3        # max tokens / temperature
"""

import os
import subprocess
import sys
import shutil
import tempfile
import argparse
from pathlib import Path

# Models directory
MODELS_DIR = Path(os.environ.get("AI_MODELS_DIR", "/usr/share/models"))
LLAMA_CLI = os.environ.get("AI_LLAMA_CLI", "/usr/bin/llama-cli")
WHISPER_CLI = "/usr/bin/whisper-cli"

# Default model (updated: TheBloke TinyLlama is archived/gated on HF,
# so we default to the curated Llama-3.2-1B Q4_K_M from bartowski)
DEFAULT_LLAMA = "Llama-3.2-1B-Instruct-Q4_K_M.gguf"
DEFAULT_WHISPER = "ggml-base.bin"

def get_memory_gb():
    """Get system memory in GB."""
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) // (1024 * 1024)
    except Exception:
        pass
    return 4  # Default

def find_model(name_pattern):
    """Find a model file matching pattern."""
    for f in MODELS_DIR.glob(name_pattern):
        return f
    return None

def check_audio():
    """Check for audio recording capability."""
    return any(shutil.which(cmd) for cmd in ["arecord", "rec", "pactl"])

def record_audio():
    """Record audio and return path."""
    wav = tempfile.mktemp(suffix=".wav")
    try:
        if shutil.which("arecord"):
            subprocess.run(["arecord", "-d", "5", "-f", "S16_LE", "-r", "16000", wav], 
                        timeout=10)
        elif shutil.which("rec"):
            subprocess.run(["rec", "-q", "-r", "16000", wav, "trim", "0:5"], timeout=10)
        return wav if Path(wav).exists() and Path(wav).stat().st_size > 1000 else None
    except Exception:
        return None

def transcribe(audio_path, model_path):
    """Transcribe audio to text using whisper-cli."""
    out_dir = tempfile.mkdtemp()
    try:
        subprocess.run([WHISPER_CLI, "-m", str(model_path), "-f", audio_path, 
                     "-o", out_dir, "--output-txt"], timeout=120)
        for f in Path(out_dir).glob("*.txt"):
            return f.read_text().strip()
    except Exception as e:
        print(f"Transcription error: {e}", file=sys.stderr)
    finally:
        shutil.rmtree(out_dir, ignore_errors=True)
    return None

def generate(prompt, model_path, max_tokens=256, temperature=0.7):
    """Generate response using llama-cli (single-shot, no interactive REPL)."""
    try:
        r = subprocess.run([LLAMA_CLI, "-m", str(model_path), "-p", prompt,
                          "-n", str(max_tokens), "--temp", str(temperature),
                          "-no-cnv"],
                        capture_output=True, text=True, timeout=180)
        return r.stdout.strip()
    except Exception as e:
        return f"Error: {e}"

def text_chat(model_path, max_tokens=256, temperature=0.7):
    """Text-only chat interface."""
    print("Yokto Chat (text mode). Ctrl+C or 'quit' to exit.")
    print(f"Model: {model_path.name}")
    while True:
        try:
            prompt = input("\n> ")
        except (EOFError, KeyboardInterrupt):
            break
        if prompt.lower() in ["quit", "exit", "q"]:
            break
        if not prompt.strip():
            continue
        print("Thinking...", file=sys.stderr)
        response = generate(prompt, model_path, max_tokens, temperature)
        print(f"\n{response}")

def voice_chat(model_path, whisper_path, max_tokens=256, temperature=0.7):
    """Voice + text chat interface."""
    print("Yokto Chat (voice mode). Ctrl+C or 'quit' to exit.")
    print(f"LLM Model: {model_path.name}")
    print(f"STT Model: {whisper_path.name}")
    while True:
        try:
            user = input("\n[Enter=speak/text=type/quit] ")
        except (EOFError, KeyboardInterrupt):
            break
        if user.lower() in ["quit", "exit", "q"]:
            break

        if user.strip():
            prompt = user
        elif check_audio():
            wav = record_audio()
            if wav:
                prompt = transcribe(wav, whisper_path)
                Path(wav).unlink(missing_ok=True)
                if not prompt:
                    print("Could not transcribe.")
                    continue
                print(f"You: {prompt}")
            else:
                print("No audio recorded.")
                continue
        else:
            continue

        print("Thinking...", file=sys.stderr)
        response = generate(prompt, model_path, max_tokens, temperature)
        print(f"\nAI: {response}")

def main():
    parser = argparse.ArgumentParser(description="Yokto Chat - AI chat for RPi5")
    parser.add_argument("--text", action="store_true", help="Text-only mode")
    parser.add_argument("-P", "--prompt", help="Single-shot prompt (non-interactive)")
    parser.add_argument("--json", action="store_true", help="Emit JSON record on stdout")
    parser.add_argument("-n", "--max-tokens", type=int, default=256, help="Max tokens")
    parser.add_argument("-t", "--temperature", type=float, default=0.7)
    parser.add_argument("--voice", action="store_true", help="Voice mode (default if audio available)")
    parser.add_argument("--model", help="Model file (default: auto-detect)")
    parser.add_argument("--whisper", help="Whisper model file (default: auto-detect)")
    args = parser.parse_args()

    # Ensure models directory exists
    MODELS_DIR.mkdir(parents=True, exist_ok=True)

    # Find models
    llama_model = Path(args.model) if args.model else find_model("*.gguf")
    if not llama_model:
        # Try default location
        llama_model = MODELS_DIR / DEFAULT_LLAMA
        print(f"Note: Place a GGUF model at {llama_model}", file=sys.stderr)

    whisper_model = Path(args.whisper) if args.whisper else find_model("ggml-*.bin")
    has_audio = check_audio()

    # Single-shot programmatic mode: answer and exit, no human interaction
    if args.prompt:
        import json as _json
        response = generate(args.prompt, llama_model, args.max_tokens, args.temperature)
        if args.json:
            print(_json.dumps({"ok": True, "model": str(llama_model),
                               "prompt": args.prompt,
                               "max_tokens": args.max_tokens,
                               "temperature": args.temperature,
                               "response": response}, ensure_ascii=False))
        else:
            print(response)
        return

    if args.voice or (not args.text and has_audio):
        if whisper_model:
            voice_chat(llama_model, whisper_model, args.max_tokens, args.temperature)
        else:
            print("No whisper model found. Use --model for LLM, --whisper for STT", file=sys.stderr)
            text_chat(llama_model, args.max_tokens, args.temperature)
    else:
        text_chat(llama_model, args.max_tokens, args.temperature)

if __name__ == "__main__":
    main()