def interactive():
    ram = get_ram_gb()
    tier = ram_tier(ram)
    print("=" * 60)
    print("  Yokto AI Menu")
    print(f"  RAM: {ram} GB ({tier} tier)  IP: {local_ip()}")
    print("=" * 60)
    while True:
        print(f"\n{'=' * 60}")
        print("  AI Menu")
        print("=" * 60)
        print("  1) Download model")
        print("  2) List models")
        print("  3) Start llama-server")
        print("  4) Stop llama-server")
        print("  5) Chat (langchain)")
        print("  6) Chat (simple llama-cli)")
        print("  7) Diagnostics")
        print("  0) Exit")
        try:
            choice = input("Select option: ").strip()
        except (EOFError, KeyboardInterrupt):
            break

        ram = get_ram_gb()
        tier = ram_tier(ram)

        if choice == "1":
            print("\nAvailable models:")
            print(model_table(ram, notes=True))
            sel = input(f"Model number [Enter=default {DEFAULT_MODEL_ID}]: ").strip()
            if sel.isdigit():
                cmd_download(arg_id=int(sel))
            elif sel:
                cmd_download(arg_name=sel)
            else:
                cmd_download(arg_id=DEFAULT_MODEL_ID)
        elif choice == "2":
            cmd_list(ram_gb=ram, verbose=True)
        elif choice == "3":
            cmd_server("start", model_ref=input(f"Model id [Enter=auto, installed: {installed_ids()}]: ").strip() or None)
        elif choice == "4":
            cmd_server("stop")
        elif choice == "5":
            run_chat("langchain", input(f"Model id [Enter=auto, installed: {installed_ids()}]: ").strip() or None)
        elif choice == "6":
            run_chat("simple", input(f"Model id [Enter=auto, installed: {installed_ids()}]: ").strip() or None)
        elif choice == "7":
            diagnostics()
        elif choice == "0":
            print("Goodbye!")
            break
        else:
            print("Invalid option")


def diagnostics():
    print("\n-- Diagnostics --")
    ram = get_ram_gb()
    print(f"RAM: {ram:.1f} GB  (tier: {ram_tier(ram)})")
    print(f"Models dir: {MODELS_DIR}  exists={MODELS_DIR.exists()}")
    if MODELS_DIR.exists():
        for f in sorted(MODELS_DIR.glob("*.gguf")):
            print(f"  {f.name}  {f.stat().st_size/1e9:.2f} GB")
    print(f"llama-server: {llama_server_bin() or 'NOT FOUND'}")
    print(f"server on :{SERVER_PORT}: {'UP' if server_reachable() else 'down'}")
    print(f"langchain-chat: {LLAMA_CHAT}  exists={LLAMA_CHAT.exists()}")
    print(f"yokto-chat:     {YOKTO_CHAT}  exists={YOKTO_CHAT.exists()}")
    try:
        import langchain  # noqa: F401
        print("langchain (python import): OK")
    except ImportError:
        print("langchain (python import): NOT AVAILABLE")


# --------------------------------------------------------------------------- #
# CLI entry point
# --------------------------------------------------------------------------- #
def main():
    ap = argparse.ArgumentParser(description="Yokto AI menu (models, server, chat)")
    # convenience flags (subcommands also exist: 'ai-menu ram', 'ai-menu list')
    ap.add_argument("--ram", action="store_true",
                    help="print detected RAM / tier")
    ap.add_argument("--list", action="store_true",
                    help="list model catalogue (echo marks fits/installed)")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("ram", help="print detected RAM / tier")
    p = sub.add_parser("list", help="list model catalogue")
    p.add_argument("--verbose", action="store_true", help="include notes column")
    p.add_argument("--json", action="store_true", help="machine-readable JSON")
    p.add_argument("--ram-gb", type=float, default=None)

    p = sub.add_parser("download", help="download a model")
    p.add_argument("--id", type=int, default=None)
    p.add_argument("--name", default=None)
    p.add_argument("--force", action="store_true")
    p.add_argument("query", nargs="?", default=None,
                   help="model id or name fragment")

    p = sub.add_parser("remove", help="remove a downloaded model")
    p.add_argument("model", nargs="?", default=None)

    p = sub.add_parser("server", help="control llama-server")
    p.add_argument("action", choices=["start", "stop", "status"])
    p.add_argument("--model", default=None)
    p.add_argument("--n-ctx", type=int, default=4096)
    p.add_argument("--threads", type=int, default=None,
                   help="cap CPU threads (power-safe default)")

    p = sub.add_parser("chat", help="run a chat")
    p.add_argument("kind", choices=["langchain", "simple"])
    p.add_argument("--model", default=None)
    p.add_argument("--tools", action="store_true",
                   help="enable tool use (langchain chat)")
    p.add_argument("-P", "--prompt", default=None)
    p.add_argument("--json", action="store_true")
    p.add_argument("-n", "--max-tokens", type=int, default=256)
    p.add_argument("-t", "--temperature", type=float, default=0.7)

    args = ap.parse_args()

    if args.cmd is None:
        if args.ram:
            return cmd_ram()
        if args.list:
            return cmd_list()
        interactive()
        return 0
    elif args.cmd == "ram":
        return cmd_ram()
    elif args.cmd == "list":
        return cmd_list(ram_gb=args.ram_gb, verbose=args.verbose, as_json=args.json)
    elif args.cmd == "download":
        q = args.query
        if q is not None and q.isdigit() and args.id is None and args.name is None:
            args.id = int(q)
        return cmd_download(arg_id=args.id, arg_name=args.name, force=args.force)
    elif args.cmd == "remove":
        return cmd_remove(args.model)
    elif args.cmd == "server":
        return cmd_server(args.action, model_ref=args.model, n_ctx=args.n_ctx,
                          threads=args.threads)
    elif args.cmd == "chat":
        return run_chat(args.kind, args.model, prompt=args.prompt,
                        json_out=args.json, max_tokens=args.max_tokens,
                        temperature=args.temperature, tools=args.tools)
    ap.print_help()
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
