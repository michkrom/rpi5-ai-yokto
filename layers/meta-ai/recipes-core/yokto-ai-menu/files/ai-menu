# --------------------------------------------------------------------------- #
# System helpers
# --------------------------------------------------------------------------- #
def get_ram_gb():
    """Total RAM in GB, rounded to .1."""
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                return round(int(line.split()[1]) / 1024 / 1024, 1)
    except Exception:
        pass
    return 4.0


def ram_tier(ram_gb):
    return "8g" if ram_gb >= 6.0 else "4g"


def local_ip():
    try:
        out = subprocess.run(["ip", "-4", "addr", "show"], capture_output=True,
                             text=True, timeout=3).stdout
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("inet ") and "127." not in line:
                return line.split()[1].split("/")[0]
    except Exception:
        pass
    return "unknown"


def server_reachable(host=SERVER_HOST, port=SERVER_PORT, timeout=1.5):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def find_model(pattern):
    """First model file in MODELS_DIR matching a name fragment or file name."""
    for m in MODELS:
        if m["file"].lower() == pattern.lower():
            p = MODELS_DIR / m["file"]
            if p.exists():
                return p
    for f in sorted(MODELS_DIR.glob("*.gguf")):
        if pattern.lower() in f.name.lower():
            return f
    return None


def resolve_model(ref):
    """ref: catalogue id (int or decimal string), name fragment, or path."""
    if ref is None:
        sym = MODELS_DIR / MODEL_SYMLINK
        return sym if sym.exists() else None
    if str(ref).isdigit():
        mid = int(ref)
        for m in MODELS:
            if m["id"] == mid:
                p = MODELS_DIR / m["file"]
                return p if p.exists() else None
    p = Path(ref)
    if p.exists():
        return p
    p = MODELS_DIR / ref
    if p.exists():
        return p
    return find_model(str(ref))


def first_installed_model():
    """Best model to use when none was selected: the stable symlink (i.e. the
    last downloaded model), else the first installed catalogue entry."""
    sym = MODELS_DIR / MODEL_SYMLINK
    if sym.exists():
        return sym
    for m in MODELS:
        p = MODELS_DIR / m["file"]
        if p.exists():
            return p
    return None


def installed_models_pretty():
    """Human list of downloaded catalogue models (id: name), e.g. '1: Qwen2.5-0.5B'."""
    parts = []
    for m in MODELS:
        if (MODELS_DIR / m["file"]).exists():
            parts.append(f"{m['id']}: {m['name']}")
    return ", ".join(parts) if parts else "(none yet)"


def download_url(m):
    """Official HF python API: hf_hub_download(repo, file, local_dir=...)."""
    return (f"huggingface_hub://{m['repo']}/{m['file']}")


def installed_ids():
    """Comma list of installed catalogue ids, e.g. '1' or '1,3'."""
    ids = [str(m["id"]) for m in MODELS if (MODELS_DIR / m["file"]).exists()]
    return ", ".join(ids) if ids else "none"


def running_model():
    """Model path currently loaded by llama-server, or None. Reads the
    -m argument from the process cmdline (no state files)."""
    for pid in _llama_pids():
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                args = f.read().split(b"\0")
            for i, a in enumerate(args):
                if a == b"-m" and i + 1 < len(args):
                    return Path(args[i + 1].decode())
        except Exception:
            continue
    return None


def hf_download(repo_id, filename, local_dir):
    """Download a model with the official huggingface_hub python API.
    Resumes partial downloads, verifies files, handles redirects/auth.
    Falls back to wget only if huggingface_hub is not available."""
    local_dir = Path(local_dir)
    local_dir.mkdir(parents=True, exist_ok=True)
    try:
        from huggingface_hub import hf_hub_download
        path = hf_hub_download(
            repo_id=repo_id,
            filename=filename,
            local_dir=str(local_dir),
        )
        return Path(path)
    except ImportError:
        # fallback: plain wget (no python API baked into the image)
        url = (f"https://huggingface.co/{repo_id}/resolve/main/{filename}"
               f"?download=true")
        dest = local_dir / filename
        tmp = local_dir / (filename + ".part")
        try:
            r = subprocess.run(["wget", "-q", "--show-progress", "-O", str(tmp), url],
                               timeout=3600)
            if r.returncode != 0:
                raise RuntimeError(f"wget failed rc={r.returncode}")
            tmp.rename(dest)
        finally:
            tmp.unlink(missing_ok=True)
        return dest


def wget_available():
    return shutil.which("wget") is not None or shutil.which("curl") is not None


