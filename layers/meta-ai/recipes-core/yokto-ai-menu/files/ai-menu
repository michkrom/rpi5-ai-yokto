def model_table(ram_gb=None, notes=False):
    """Column-based human listing: ID, Model, Params, Size, RAM, Install, Notes."""
    ram_gb = ram_gb or get_ram_gb()
    tier = ram_tier(ram_gb)
    rows = []
    for m in MODELS:
        p = MODELS_DIR / m["file"]
        inst = p.exists()
        size = round(p.stat().st_size / 1e9, 1) if inst else m["gb"]
        fits = m["ram"] == "4g" or tier == "8g"
        rows.append({"id": m["id"], "name": m["name"],
                     "params": PARAMS.get(m["id"], ""),
                     "size": size, "ram": m["ram"], "fits": fits, "inst": inst,
                     "def": m["id"] == DEFAULT_MODEL_ID,
                     "note": m["note"] if notes else ""})
    w_name = max(len(r["name"]) for r in rows)
    w_par = max(max(len(r["params"]) for r in rows), 6)
    w_ram = max(len(r["ram"]) for r in rows)
    w_note = max(len(r["note"]) for r in rows) if notes else 0
    hdr = (f"{'':4}{'Model':<{w_name}}  {'Params':>{w_par}}  {'Size':>5}"
           f"  {'RAM':>{w_ram}}  {'Install':>7}")
    if notes:
        hdr += "  Notes"
    out = [f"RAM: {ram_gb:.1f} GB  (tier {tier})", "", hdr, "-" * len(hdr)]
    for r in rows:
        star = "*" if r["def"] else " "
        fit = "" if r["fits"] else " !"
        line = (f"{r['id']:>2}{star}  {r['name']:<{w_name}}  "
                f"{r['params']:>{w_par}}  {r['size']:>4.1f}G  "
                f"{r['ram']}{fit:<4}  {'yes' if r['inst'] else 'no':>7}")
        if notes:
            line += f"  {r['note']}"
        out.append(line)
    out += ["", "* default model    ! too big for this board's RAM tier"]
    return "\n".join(out)


def cmd_list(ram_gb=None, verbose=False, as_json=False):
    ram_gb = ram_gb or get_ram_gb()
    if not as_json:
        print(model_table(ram_gb, notes=verbose))
        return 0
    tier = ram_tier(ram_gb)
    lines = []
    for m in MODELS:
        p = MODELS_DIR / m["file"]
        installed = p.exists()
        size_gb = round(p.stat().st_size / 1e9, 2) if installed else m["gb"]
        fits = m["ram"] == "4g" or tier == "8g"
        lines.append({
            "id": m["id"], "name": m["name"], "params": PARAMS.get(m["id"], ""),
            "file": m["file"], "size_gb": size_gb, "ram": m["ram"],
            "fits": fits, "installed": installed,
            "note": m["note"] if verbose else None,
        })
    out = {"ram_gb": ram_gb, "tier": tier, "models": lines}
    print(json.dumps(out, indent=2 if verbose else None))
    return out


def cmd_download(arg_id=None, arg_name=None, force=False):
    MODELS_DIR.mkdir(parents=True, exist_ok=True)
    target = None
    if arg_id is not None:
        target = next((m for m in MODELS if m["id"] == int(arg_id)), None)
        if target is None:
            print(f"error: no catalogue id {arg_id}", file=sys.stderr)
            return 2
    elif arg_name:
        hit = [m for m in MODELS
               if arg_name.lower() in m["name"].lower()
               or arg_name.lower() in m["file"].lower()]
        if not hit:
            print(f"error: no model matches '{arg_name}'", file=sys.stderr)
            return 2
        target = hit[0]
    else:
        target = MODELS[DEFAULT_MODEL_ID - 1]
    target = dict(target)

    dest = MODELS_DIR / target["file"]
    if dest.exists() and not force:
        print(json.dumps({"ok": True, "already_present": str(dest),
                          "size_gb": round(dest.stat().st_size / 1e9, 2)}))
        return 0

    url = download_url(target)
    print(f"downloading {target['name']} ({target['gb']} GB)", file=sys.stderr)
    print(f"  {url}", file=sys.stderr)
    start = time.time()
    try:
        dest = hf_download(target["repo"], target["file"], MODELS_DIR)
        if dest != MODELS_DIR / target["file"]:
            # huggingface_hub resolved to a cached/elsewhere path - copy over
            if dest.exists() and dest != MODELS_DIR / target["file"]:
                (MODELS_DIR / target["file"]).write_bytes(dest.read_bytes())
                dest = MODELS_DIR / target["file"]
    except Exception as e:
        print(f"error: download failed: {e}", file=sys.stderr)
        return 1

    sym = MODELS_DIR / MODEL_SYMLINK   # stable name for llama-server.service
    sym.unlink(missing_ok=True)
    sym.symlink_to(dest.name)
    print(json.dumps({"ok": True, "path": str(dest),
                      "size_gb": round(dest.stat().st_size / 1e9, 2),
                      "symlink": str(sym),
                      "elapsed_s": round(time.time() - start, 1)}))
    return 0


def cmd_remove(pattern):
    p = resolve_model(pattern)
    if p is None:
        print(f"error: no model matches '{pattern}'", file=sys.stderr)
        return 2
    sym = MODELS_DIR / MODEL_SYMLINK
    if sym.exists() and sym.resolve() == p.resolve():
        sym.unlink(missing_ok=True)
    p.unlink(missing_ok=True)
    print(json.dumps({"ok": True, "removed": str(p)}))
    return 0


def llama_server_bin():
    if LLAMA_SERVER:
        return LLAMA_SERVER if Path(LLAMA_SERVER).exists() else None
    return shutil.which("llama-server")


def default_threads():
    """Cored-limit for power: on a Pi 5 brownouts happen when all 4 Cortex-A76
    cores spin up at max current, so default to nproc-1 but max 3 and min 2.
    Override with AI_THREADS."""
    try:
        n = int(os.environ.get("AI_THREADS", "0"))
        if n > 0:
            return n
        n = (os.cpu_count() or 4) - 1
    except Exception:
        n = 3
    return max(2, min(n, 3))


def _llama_pids():
    """Return pids of running llama-server via busybox-style `ps w`."""
    pids = []
    try:
        out = subprocess.run(["ps", "w"], capture_output=True, text=True,
                             timeout=5).stdout
        for line in out.splitlines():
            if "llama-server" in line and "grep" not in line:
                parts = line.split()
                if parts and parts[0].isdigit():
                    pids.append(parts[0])
    except Exception:
        pass
    return pids


def cmd_server(action, model_ref=None, n_ctx=4096, detach=True, threads=None):
    if action == "status":
        up = server_reachable()
        print(json.dumps({"running": up, "host": SERVER_HOST,
                          "port": SERVER_PORT}))
        return 0 if up else 1

    bin_path = llama_server_bin()
    if bin_path is None:
        print("error: llama-server binary not found", file=sys.stderr)
        return 1

    if action == "stop":
        # No pkill on busybox and no systemd dependency: find the pid and kill.
        for sig in ("TERM", "KILL"):
            if not server_reachable():
                break
            for pid in _llama_pids():
                subprocess.run(["kill", "-" + sig, pid], capture_output=True)
            time.sleep(1.5)
        print(json.dumps({"ok": True, "running": server_reachable()}))
        return 0 if not server_reachable() else 1

    if action == "start":
        explicit = model_ref is not None and str(model_ref).strip() != ""
        # explicit id/name -> strict; Enter (None) -> installed/auto model
        model = resolve_model(model_ref) if explicit else first_installed_model()
        if model is None:
            if explicit:
                print(f"error: model '{model_ref}' is not installed. "
                      f"Installed: {installed_models_pretty()}", file=sys.stderr)
            else:
                print("error: no model installed.", file=sys.stderr)
            print("hint: ai-menu download <id>  (e.g. 1 = Qwen2.5-0.5B, "
                  "small and fast)", file=sys.stderr)
            return 2
        if server_reachable():
            cur = running_model()
            if explicit and cur is not None and \
                    Path(cur).resolve() != Path(model).resolve():
                print(f"server runs {Path(cur).name}; restarting with "
                      f"{Path(model).name}...", file=sys.stderr)
                cmd_server("stop")
            else:
                print(json.dumps({"ok": True, "already_running": True,
                                  "model": str(model)}))
                return 0
        cmd = [bin_path, "-m", str(model), "--host", SERVER_HOST,
               "--port", str(SERVER_PORT), "-c", str(n_ctx),
               "-t", str(default_threads() if threads is None else threads),
               "-tb", str(default_threads() if threads is None else threads)]
        log = Path("/tmp/llama-server.log")
        print(f"starting llama-server: {' '.join(cmd)}", file=sys.stderr)
        if not detach:
            return subprocess.run(cmd).returncode
        with log.open("a") as lf:
            subprocess.Popen(cmd, stdout=lf, stderr=lf, start_new_session=True)
        for _ in range(int(os.environ.get("AI_WAIT_SERVER", "60"))):
            if server_reachable():
                break
            time.sleep(1)
        up = server_reachable()
        print(json.dumps({"ok": up, "running": up, "model": str(model),
                          "log": str(log)}))
        return 0 if up else 1

    print(f"error: unknown server action {action}", file=sys.stderr)
    return 1


def run_chat(kind, model_ref=None, prompt=None, json_out=False, max_tokens=256,
             temperature=0.7, tools=False):
    explicit = model_ref is not None and str(model_ref).strip() != ""
    model = resolve_model(model_ref) if explicit else first_installed_model()
    if model is None:
        if explicit:
            print(f"error: model '{model_ref}' is not installed. "
                  f"Installed: {installed_models_pretty()}", file=sys.stderr)
        else:
            print("error: no model installed - run 'ai-menu download' first "
                  "(see 'ai-menu list' for the catalogue)", file=sys.stderr)
        return 2
    if kind == "langchain":
        script = LLAMA_CHAT
        if not script.exists():
            print(f"error: {script} not installed (bake python3-langchain "
                  f"into the image)", file=sys.stderr)
            return 1
        # langchain chat talks to llama-server: ensure it runs the requested
        # model, restarting it if a different one is currently loaded
        if server_reachable():
            cur = running_model()
            if explicit and cur is not None and \
                    Path(cur).resolve() != Path(model).resolve():
                print(f"server runs {Path(cur).name}; switching to "
                      f"{Path(model).name}...", file=sys.stderr)
                cmd_server("stop")
        if not server_reachable():
            print("starting llama-server...", file=sys.stderr)
            rc = cmd_server("start", model_ref=model)
            if rc != 0:
                print("error: could not start llama-server", file=sys.stderr)
                return 1
        argv = [sys.executable, str(script), "-m", model.name]
        if tools:
            argv.append("--tools")
        if prompt:
            argv += ["-P", prompt]
        argv += ["-n", str(max_tokens), "-t", str(temperature)]
        if json_out:
            argv.append("--json")
    elif kind == "simple":
        script = YOKTO_CHAT
        if not script.exists():
            print(f"error: {script} not installed", file=sys.stderr)
            return 1
        argv = [sys.executable, str(script), "--text", "--model", str(model)]
        if prompt:
            argv += ["--prompt", prompt]
        argv += [f"--max-tokens={max_tokens}", f"--temperature={temperature}"]
        if json_out:
            argv.append("--json")
    else:
        print(f"error: unknown chat kind '{kind}'", file=sys.stderr)
        return 1

    r = subprocess.run(argv)
    return r.returncode


